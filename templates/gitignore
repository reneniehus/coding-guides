# Copy to the project root as .gitignore before the first commit, then edit.
# Every entry says why it is here. Ignoring a file after it was committed does not
# remove it from history.

# ---- R and RStudio session files ----
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# ---- machine-specific settings; may hold paths or secrets (.Renviron.example is committed) ----
.Renviron

# ---- renv: the library is rebuilt from renv.lock ----
renv/library/
renv/staging/
renv/local/

# ---- compiled Stan models: rebuilt from the .stan files ----
stan/*
!stan/*.stan

# ---- regenerated outputs: never committed ----
output/cache/
output/fits/
output/logs/
# Committed outputs: <the small tables and figures a deliverable needs without the heavy
# inputs, e.g. output/tables/*.csv>, because <reason>. Everything else in output/ is
# regenerated by ./reproduce.sh.

# ---- private or restricted inputs: NEVER commit; list each by exact path and say why ----
# data/<source>/<file>_restricted.xlsx    # <who may see it, and why it is restricted>
# data/<source>/redaction_names.csv       # private input to the de-identification script

# ---- scratch and system files ----
.DS_Store
*.tmp

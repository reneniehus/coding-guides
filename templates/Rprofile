# Copy to the project root as .Rprofile. Sets a dated Posit Package Manager (P3M) snapshot,
# then activates renv. The date fixes which package versions renv::restore() installs on any
# machine; change it only in a commit that also updates renv.lock. On Linux the binary URL
# of the machine's own distribution is used, read from /etc/os-release; on macOS and Windows
# the plain dated URL, from which P3M serves CRAN binaries for those systems.
# If renv stays inactive, check RENV_CONFIG_AUTOLOADER_ENABLED: FALSE stops activate.R.
local({
  p3m_date <- "<YYYY-MM-DD>"  # on or after the day the library was installed or restored
  os_release <- if (file.exists("/etc/os-release")) readLines("/etc/os-release") else character()
  codename_line <- grep("^VERSION_CODENAME=", os_release, value = TRUE)
  codename <- gsub("^VERSION_CODENAME=|\"", "", codename_line)  # e.g. noble, jammy
  p3m_path <- if (length(codename) == 1 && nzchar(codename)) {
    paste0("__linux__/", codename, "/")  # Linux binaries for this distribution
  } else {
    ""  # macOS and Windows
  }
  options(repos = c(P3M = paste0("https://packagemanager.posit.co/cran/", p3m_path, p3m_date)))
})
source("renv/activate.R")
